# 이 파일을 프로젝트 폴더 안에서 .env로 복사합니다. .env는 GitHub에 올라가지 않습니다.
# 주제(DATASET)는 steps/lesson_settings.py에서 팀이 함께 정합니다.
# 내 실험 결과 폴더 이름. 팀원마다 다르게 적습니다(예: learner02). 비우면 learner01을 씁니다.
LEARNER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
MAX_INPUT_CHARS=4000
MAX_OUTPUT_TOKENS=512
GENERATION_TIMEOUT_SECONDS=120
# 상용 API 단가(USD, 100만 토큰당). 요금표를 확인해 적으면 step09 요약에 예상 비용이 계산됩니다.
OPENAI_INPUT_USD_PER_1M=
OPENAI_OUTPUT_USD_PER_1M=
