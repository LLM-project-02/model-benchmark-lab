{
  "kind": "baseline",
  "dataset": "klue_nli",
  "input": "premise + hypothesis pair",
  "labels": [
    "entailment",
    "neutral",
    "contradiction"
  ],
  "ngram_range": [
    2,
    5
  ],
  "max_features": 100000,
  "features": "[premise, hypothesis, |premise-hypothesis|, premise*hypothesis]",
  "seed": 42
}