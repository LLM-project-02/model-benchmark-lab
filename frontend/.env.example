# 이 파일을 .env.local로 복사해 값을 바꾼다. (.env.local은 git에 올라가지 않는다)
# 값을 바꾼 뒤에는 개발 서버(npm run dev)를 다시 켠다.

# 화면 모드: mock(백엔드 없이 예시 응답) 또는 api(백엔드 호출). 서비스마다 따로 정한다.
# 기본값은 세 탭 모두 api (댓글 dfd8672 step10, 보고서 NLI e324cb1, 파이프라인 비교 연구용 API)
VITE_COMMENTS_MODE=api
VITE_NLI_MODE=api
# 파이프라인 비교 탭 · 댓글 (연구용 API, 댓글 연구 브랜치의 scripts/comments_research_api.py)
VITE_RESEARCH_MODE=api
# 파이프라인 비교 탭 · 보고서 (연구용 API, feature/nli-pipeline-research의 nli/research_api.py)
VITE_NLI_RESEARCH_MODE=api

# 개발 서버 proxy가 접속할 백엔드 주소 (브라우저가 아니라 vite가 접속한다)
# 두 서비스 모두 코드 기본 포트가 8000이라 NLI는 8001로 띄우는 것을 기준으로 했다.
COMMENTS_API_TARGET=http://127.0.0.1:8000
NLI_API_TARGET=http://127.0.0.1:8001
# /api/research/* → {RESEARCH_API_TARGET}/research/*
RESEARCH_API_TARGET=http://127.0.0.1:8002
# /api/nli-research/* → {NLI_RESEARCH_API_TARGET}/research/*
NLI_RESEARCH_API_TARGET=http://127.0.0.1:8003

# 브라우저가 요청할 주소 앞부분. 기본값은 위 proxy 경로다.
# 배포 시에는 같은 origin의 reverse proxy 경로를 쓰거나, CORS를 허용한 절대 주소를 넣는다.
# VITE_COMMENTS_API_BASE=/api/comments
# VITE_NLI_API_BASE=/api/nli
# VITE_RESEARCH_API_BASE=/api/research
# VITE_NLI_RESEARCH_API_BASE=/api/nli-research

# 응답 대기 한도(밀리초). 첫 요청은 모델 로딩으로 오래 걸릴 수 있다.
# VITE_REQUEST_TIMEOUT_MS=300000

# 서버의 MAX_INPUT_CHARS를 바꿨다면 같은 값으로 맞춘다.
# VITE_MAX_INPUT_CHARS=4000
